#!/usr/bin/env python3
import sys
import argparse
import asyncio
from src.logic.agent_manager import manager

async def run_ask(agente, query):
    from src.api.groq_client import oraculo
    from src.logic.identity_matrix import AGENT_IDENTITIES

    agente_id = agente.upper()
    if agente_id in AGENT_IDENTITIES:
        print(f"\n[\033[95m INVOKING {agente_id} \033[0m]")
        respuesta = await oraculo.consultar(query, agente_id=agente_id)
        print(f"\n{respuesta}\n")
    else:
        print(f"\x1b[1;31mError: El agente {agente_id} no existe en la Identity Matrix.\x1b[0m")

def main():
    parser = argparse.ArgumentParser(description="SHADOW_GRIMORIO CLI - Control del Enjambre")
    subparsers = parser.add_subparsers(dest="command")

    # Comando: shadow ask [AGENTE] [QUERY]
    ask_p = subparsers.add_parser("ask", help="Pregunta a un agente específico")
    ask_p.add_argument("agente", help="Nombre del agente (VOID_HUNTER, GHOST_CODER, etc.)")
    ask_p.add_argument("query", help="Consulta o tarea")

    # Comando: shadow status
    subparsers.add_parser("status", help="Estado de los procesos de fondo")

    # Comando: shadow kill
    subparsers.add_parser("kill", help="Aniquilar todos los agentes")

    # Comando: shadow start
    subparsers.add_parser("start", help="Lanzar interfaz TUI")

    args = parser.parse_args()

    if args.command == "ask":
        asyncio.run(run_ask(args.agente, args.query))
    
    elif args.command == "status":
        print("\n--- ESTADO DEL ENJAMBRE ---")
        agentes = manager.listar_agentes()
        if not agentes:
            print("No hay agentes detectados en src/logic/agents/")
        for name, status in agentes.items():
            color = "\033[92m" if status == "on" else "\033[91m"
            print(f"[{color}{status.upper()}\033[0m] Agente: {name}")

    elif args.command == "kill":
        manager.matar_todo()

    elif args.command == "start":
        from src.tui.app import ShadowGrimorio
        app = ShadowGrimorio()
        app.run()

    else:
        parser.print_help()

if __name__ == "__main__":
    main()

