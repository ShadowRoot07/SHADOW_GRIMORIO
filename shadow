#!/usr/bin/env python3
import sys
import os
import argparse
import asyncio
import io

# --- PROTOCOLO DE LOCALIZACIÓN ---
# Forzamos que el script conozca su base aunque se llame desde fuera
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.append(BASE_DIR)

# --- IMPORTACIONES DEL GRIMORIO ---
from src.database.manager import db
from src.logic.agent_manager import manager

# --- PROTOCOLO DE INICIO SEGURO ---
def verificar_entorno():
    """Inicializa la DB y asegura que las llaves existan."""
    # 1. Inicializar motores de base de datos obligatoriamente
    db.init_db()
    
    try:
        from src.logic.init_profile import ProfileManager
        # Solo ejecutamos si estamos en una terminal interactiva
        if sys.stdin.isatty():
            if ProfileManager.es_primera_vez():
                print("\033[93m[!] Iniciando Secuencia de Seguridad: Generando Master Key...\033[0m")
                ProfileManager.generar_llave_maestra()
    except Exception as e:
        # Si falla el perfil, notificamos pero permitimos seguir si no es crítico
        pass

async def run_ask(agente, query):
    from src.api.groq_client import oraculo
    from src.logic.identity_matrix import AGENT_IDENTITIES

    agente_id = agente.upper()
    if agente_id in AGENT_IDENTITIES or agente.lower() == "survival":
        print(f"\n[\033[95m INVOKING {agente_id} \033[0m]")
        respuesta = await oraculo.consultar(query, agente_id=agente_id)
        print(f"\n{respuesta}\n")
    else:
        print(f"\x1b[1;31mError: El agente {agente_id} no existe.\x1b[0m")

def main():
    # El ritual de inicio debe ser lo primero
    verificar_entorno()

    parser = argparse.ArgumentParser(description="SHADOW_GRIMORIO CLI - Control del Enjambre")
    subparsers = parser.add_subparsers(dest="command")

    # --- COMANDOS NÚCLEO ---
    subparsers.add_parser("ui", help="Lanzar interfaz TUI (Matriz Visual)")
    subparsers.add_parser("status", help="Estado de los procesos de fondo")
    subparsers.add_parser("kill", help="Aniquilar todos los procesos del enjambre")

    # --- COMANDOS DE SEGURIDAD ---
    subparsers.add_parser("lazaro", help="Protocolo Lázaro: Recuperar botín desde la nube")
    subparsers.add_parser("purge", help="CÓDIGO ROJO: Eliminar datos locales sensibles")

    # --- COMANDOS DE AGENTES ---
    start_p = subparsers.add_parser("start", help="Despertar agente en segundo plano")
    start_p.add_argument("agente")

    ask_p = subparsers.add_parser("ask", help="Consulta directa al Oráculo")
    ask_p.add_argument("agente")
    ask_p.add_argument("query")

    args = parser.parse_args()

    # --- LÓGICA DE EJECUCIÓN ---
    if args.command == "ui":
        from src.tui.app import ShadowGrimorio
        from src.logic.init_profile import ProfileManager
        es_nuevo = ProfileManager.es_primera_vez()
        punto_ejecucion = os.getcwd() 
        
        app = ShadowGrimorio(es_primera_vez=es_nuevo, cwd_inicio=punto_ejecucion)
        app.run()

    elif args.command == "lazaro":
        from src.logic.lazaro_protocol import lazaro
        asyncio.run(lazaro.ejecutar())

    elif args.command == "purge":
        print("\033[91m")
        confirm = input("⚠️ ¿ESTÁS SEGURO? Esto borrará .env, DB y config local (s/n): ")
        print("\033[0m")
        if confirm.lower() == 's':
            from src.logic.utils import ejecutar_purga
            ejecutar_purga()
        else:
            print("Purga abortada. Los datos están a salvo.")

    elif args.command == "start":
        if manager.encender_agente(args.agente):
            print(f"🚀 [\033[92mOK\033[0m] Agente '{args.agente}' despertado.")
        else:
            print(f"❌ [\033[91mERROR\033[0m] Revisa logs/shadow_grimorio.log")

    elif args.command == "status":
        print("\n\033[1m--- ESTADO DEL ENJAMBRE ---\033[0m")
        agentes = manager.listar_agentes()
        if not agentes:
            print("No hay agentes activos en las sombras.")
        for name, status in agentes.items():
            color = "\033[92m" if status == "on" else "\033[91m"
            print(f"[{color}{status.upper()}\033[0m] Agente: {name}")

    elif args.command == "kill":
        manager.matar_todo()
        print("💀 [\033[91mPURGA\033[0m] Procesos aniquilados.")

    elif args.command == "ask":
        asyncio.run(run_ask(args.agente, args.query))

    else:
        parser.print_help()

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\033[93mInterrupción detectada. Cerrando CLI...\033[0m")
        sys.exit(0)
    finally:
        # Aseguramos liberar conexiones al terminar cualquier comando
        db.shutdown()

